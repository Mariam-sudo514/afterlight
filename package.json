{
  "name": "afterlight",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3300",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3300",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "local:start": "node scripts/local.mjs start",
    "local:stop": "node scripts/local.mjs stop",
    "local:restart": "node scripts/local.mjs restart",
    "local:status": "node scripts/local.mjs status",
    "local:seed": "node scripts/seed.mjs",
    "local:owner": "node scripts/create-owner.mjs",
    "test:unit": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:integration": "node scripts/check-integration.mjs",
    "test:sql": "node scripts/local.mjs test-sql",
    "local:test:stop": "node scripts/local.mjs test-stop",
    "cloud:setup": "node scripts/cloud.mjs setup",
    "cloud:check": "node scripts/cloud.mjs check",
    "cloud:prepare": "node scripts/cloud.mjs prepare",
    "cloud:link": "node scripts/cloud.mjs link",
    "cloud:plan": "node scripts/cloud.mjs plan",
    "cloud:migrate": "node scripts/cloud.mjs migrate",
    "cloud:build": "node scripts/cloud.mjs build",
    "cloud:owner": "node scripts/create-owner.mjs --cloud",
    "content:export": "node --import tsx scripts/transfer-content.mjs export",
    "content:import": "node --import tsx scripts/transfer-content.mjs import"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
