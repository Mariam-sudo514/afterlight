# Separate cloud configuration. Copy to .env.cloud.local; never overwrite .env.local.
# The supplied NEXT_PUBLIC_SUPABASE_URL maps to this server-side variable:
SUPABASE_URL=https://npadcumzuahkqulhpimi.supabase.co
# The supplied NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY maps to this variable:
SUPABASE_PUBLISHABLE_KEY=
# From this project's Settings > API Keys > Secret keys. Server only.
SUPABASE_SECRET_KEY=
# Set once the Vercel project URL or custom domain is known:
SITE_ORIGIN=
ALLOWED_ORIGINS=
